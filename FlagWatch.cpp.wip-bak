// FlagWatch.cpp — Hardware-breakpoint layer to catch the unknown writer of
// TESObjectREFR::flags bits 5 (0x20) and 11 (0x800).
//
// SAFETY WARNING FOR FUTURE MAINTAINERS:
//   While a watchpoint is armed on refr->flags (+0x08), ANY write to that
//   address from ANY thread in this process will fire EXCEPTION_SINGLE_STEP.
//   The VEH handler is non-reentrant (serialized via s_busy interlocked flag).
//   NEVER write to refr->flags (or any watched refr's +0x08) from FlagWatch
//   code or any other StormLog code while the watchpoint is armed.
//   The existing Pipeline/HookL1/HookL3 code does NOT touch refr flags, so
//   we are safe — but verify before adding any new code that touches REFR state.

#include "FlagWatch.h"
#include "Config.h"
#include "obse/GameAPI.h"
#include <windows.h>
#include <tlhelp32.h>
#include <thread>
#include <atomic>
#include <unordered_set>
#include <cstdio>
#include "Detours/detours.h"

#pragma comment(lib, "Detours/detours.lib")

namespace StormLog {
namespace FlagWatch {

// ---------------------------------------------------------------------------
