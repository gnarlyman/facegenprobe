// ---------------------------------------------------------------------------
// Character::Set3D hook
// ---------------------------------------------------------------------------
// Character::Set3D — __thiscall(refr, newModel). xOBSE GameObjects.cpp line 19
// confirms this address. Fires on every actor model attach/detach including
// the per-frame Set3D(NULL) cancellation calls that drive the storm.
typedef void (__fastcall* fn_CharacterSet3D)(void* refr, void* /*edx*/, void* newModel);
static fn_CharacterSet3D s_orig_CharacterSet3D = (fn_CharacterSet3D)0x0060E430;

// ---------------------------------------------------------------------------
// Watchpoint state
// ---------------------------------------------------------------------------
static std::atomic<bool>     g_armed        { false };
static std::atomic<uint32_t> g_hit_count    { 0 };
static std::atomic<bool>     g_stop         { false };
static DWORD                 g_watcher_thread_id = 0;
static DWORD                 g_armed_target      = 0;
static HANDLE                g_veh_handle        = nullptr;

// Set of thread IDs that currently have DR0 armed.
static std::unordered_set<DWORD> g_armed_threads;

// ---------------------------------------------------------------------------
// Forward declarations
// ---------------------------------------------------------------------------
static void ArmWatchpointOnAllThreads(DWORD target);
static void DisarmWatchpointOnAllThreads();
static LONG WINAPI OnException(EXCEPTION_POINTERS* ep);

// ---------------------------------------------------------------------------
// ArmWatchpointOnThread — internal, caller holds no locks
// ---------------------------------------------------------------------------
static void ArmWatchpointOnThread(DWORD tid, DWORD target)
{
    HANDLE h = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT | THREAD_SUSPEND_RESUME,
                          FALSE, tid);
    if (!h || h == INVALID_HANDLE_VALUE) return;

    SuspendThread(h);

    CONTEXT ctx;
    ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
    if (GetThreadContext(h, &ctx)) {
        ctx.Dr0 = target;
        // DR7 layout for DR0:
        //   bit  0    (L0)  = 1  — local enable for DR0
        //   bit  1    (G0)  = 0  — global enable (not set)
        //   bits 16-17 (R/W0) = 01 — write watchpoint
        //   bits 18-19 (LEN0) = 11 — 4-byte width
        // Full field = L0=1, R/W0=01, LEN0=11
        //   => condition bits [19:16] = 1101 = 0xD, local-enable bit 0 = 1
        //   => mask to clear DR0's state: ~0x000F0003 (clears L0/G0 + condition/len)
        //   => set:  0x000D0001
        // This preserves DR1-DR3 enable bits unchanged.
        ctx.Dr7 = (ctx.Dr7 & ~0x000F0003u) | 0x000D0001u;
        SetThreadContext(h, &ctx);
    }

    ResumeThread(h);
    CloseHandle(h);
    g_armed_threads.insert(tid);
}

// ---------------------------------------------------------------------------
// ArmWatchpointOnAllThreads
// ---------------------------------------------------------------------------
static void ArmWatchpointOnAllThreads(DWORD target)
{
    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
    if (snap == INVALID_HANDLE_VALUE) return;

    DWORD myPid     = GetCurrentProcessId();
    DWORD skipBgTid   = g_watcher_thread_id;     // don't watch our own bg thread
    DWORD skipSelfTid = GetCurrentThreadId();    // don't suspend the thread that called us

    THREADENTRY32 te;
    te.dwSize = sizeof(te);
    if (Thread32First(snap, &te)) {
        do {
            if (te.th32OwnerProcessID != myPid) continue;
            if (te.th32ThreadID == skipBgTid)   continue;
            if (te.th32ThreadID == skipSelfTid) continue;
            ArmWatchpointOnThread(te.th32ThreadID, target);
        } while (Thread32Next(snap, &te));
    }
    CloseHandle(snap);
}

// ---------------------------------------------------------------------------
// DisarmWatchpointOnAllThreads — used during Shutdown
// ---------------------------------------------------------------------------
static void DisarmWatchpointOnAllThreads()
{
    for (DWORD tid : g_armed_threads) {
        HANDLE h = OpenThread(THREAD_GET_CONTEXT | THREAD_SET_CONTEXT | THREAD_SUSPEND_RESUME,
                              FALSE, tid);
        if (!h || h == INVALID_HANDLE_VALUE) continue;
        SuspendThread(h);
        CONTEXT ctx;
        ctx.ContextFlags = CONTEXT_DEBUG_REGISTERS;
        if (GetThreadContext(h, &ctx)) {
            ctx.Dr0  = 0;
            ctx.Dr7 &= ~0x000F0003u; // clear DR0 enable + condition
            ctx.Dr6  = 0;
            SetThreadContext(h, &ctx);
        }
        ResumeThread(h);
        CloseHandle(h);
    }
    g_armed_threads.clear();
}

// ---------------------------------------------------------------------------
// TESCharacter::Update hook
// ---------------------------------------------------------------------------
static volatile LONG g_diag_count = 0;

static void __fastcall Hook_TESCharUpdate(void* refr, void* /*edx*/, uint32_t param)
{
#pragma warning(suppress: 4509)
    if (refr && !g_armed.load(std::memory_order_relaxed)) {
        uint32_t refrFID = 0;
        uint32_t npcFID  = 0;
        void*    npc     = nullptr;

        __try {
            refrFID = *(uint32_t*)((char*)refr + 0x0C);
            npc = *(void**)((char*)refr + 0x40);
            if (npc) {
                npcFID = *(uint32_t*)((char*)npc + 0x0C) & 0x00FFFFFFu;
            }
        } __except(EXCEPTION_EXECUTE_HANDLER) {
            refrFID = 0;
            npcFID  = 0;
        }

        // First 10 fires: log unconditionally so we can see what's coming through.
        LONG dn = InterlockedIncrement(&g_diag_count);
        if (dn <= 10) {
            _MESSAGE("[FlagWatch] DIAG #%ld refr=%p refrFID=%08X npc=%p npcFID=%08X",
                     dn, refr, refrFID, npc, npcFID);
        }

        if (npcFID != 0) {
            bool tracked = false;
            for (size_t i = 0; i < sizeof(kTrackedFormIDs)/sizeof(kTrackedFormIDs[0]); ++i) {
                if (npcFID == kTrackedFormIDs[i]) { tracked = true; break; }
            }

            if (tracked) {
                DWORD target = (DWORD)refr + 0x08;
                g_armed_target = target;
                ArmWatchpointOnAllThreads(target);
                g_armed.store(true, std::memory_order_relaxed);
                _MESSAGE("[FlagWatch] armed on refr=%p npcFID=%08X target=%p",
                         refr, npcFID, (void*)target);
            }
        }
    }

    s_orig_TESCharUpdate(refr, nullptr, param);
}

// ---------------------------------------------------------------------------
// VEH handler
// ---------------------------------------------------------------------------
// Static 1024-byte buffer for formatting; serialized via s_busy interlocked flag.
// NO heap allocation permitted in VEH context.
static char           s_veh_buf[1024];
static volatile LONG  s_busy = 0;

static LONG WINAPI OnException(EXCEPTION_POINTERS* ep)
{
    if (ep->ExceptionRecord->ExceptionCode != EXCEPTION_SINGLE_STEP)
        return EXCEPTION_CONTINUE_SEARCH;

    // Check DR6 bit 0 — means DR0 fired.
    CONTEXT* ctx = ep->ContextRecord;
    if (!(ctx->Dr6 & 0x1u))
        return EXCEPTION_CONTINUE_SEARCH;

    uint32_t n = ++g_hit_count;

    if (n > 5) {
        // Disarm DR0 on this thread and stop further firings.
        ctx->Dr7 &= ~0x000F0003u;
        ctx->Dr6  = 0;
        ctx->EFlags |= 0x10000u; // RF — Resume Flag, suppresses refire on same instruction
        return EXCEPTION_CONTINUE_EXECUTION;
    }

    // Serialize concurrent VEH firings so we don't interleave into s_veh_buf.
    while (InterlockedCompareExchange(&s_busy, 1, 0) != 0) {
        // Spin — this should be extremely rare (at most a handful of hits).
    }

    // Walk up to 8 stack frames via EBP chain.
    DWORD frames[8] = {0};
    DWORD ebp = ctx->Ebp;
    for (int fi = 0; fi < 8; ++fi) {
        if (IsBadReadPtr((void*)ebp, 8)) break;
        frames[fi] = *((DWORD*)ebp + 1); // return address is ebp+4
        DWORD next = *(DWORD*)ebp;        // saved ebp
        if (next == 0 || next <= ebp)     break; // guard against corrupt chain
        ebp = next;
    }

#pragma warning(suppress: 4996)
    _snprintf(s_veh_buf, sizeof(s_veh_buf),
        "[FlagWatch] hit#%u tid=0x%X EIP=0x%08X DR6=0x%08X "
        "stack=[%08X %08X %08X %08X %08X %08X %08X %08X]",
        n,
        (unsigned)GetCurrentThreadId(),
        (unsigned)ctx->Eip,
        (unsigned)ctx->Dr6,
        (unsigned)frames[0], (unsigned)frames[1], (unsigned)frames[2], (unsigned)frames[3],
        (unsigned)frames[4], (unsigned)frames[5], (unsigned)frames[6], (unsigned)frames[7]);

    // Log to file — slow but acceptable for <= 5 hits.
    FILE* f = nullptr;
    // Ensure the output directory exists.
    CreateDirectoryA("Data\\OBSE\\Plugins\\StormLog", NULL);
    fopen_s(&f, "Data\\OBSE\\Plugins\\StormLog\\flagwatch.log", "a");
    if (f) {
        fprintf(f, "%s\n", s_veh_buf);
        fclose(f);
    }

    // Also emit to OBSE log (safe — uses OutputDebugStringA internally, no heap on hot path).
    _MESSAGE("%s", s_veh_buf);

    InterlockedExchange(&s_busy, 0);

    // Clear DR6 and set RF so we don't refire on the exact same instruction.
    ctx->Dr6    = 0;
    ctx->EFlags |= 0x10000u; // RF

    return EXCEPTION_CONTINUE_EXECUTION;
}

// ---------------------------------------------------------------------------
// Background re-enumerator thread
// ---------------------------------------------------------------------------
static std::thread* g_watcher_thread = nullptr;

static void WatcherThreadProc()
{
    // Record our own thread ID so ArmWatchpointOnAllThreads can skip us.
    g_watcher_thread_id = GetCurrentThreadId();

    while (!g_stop.load(std::memory_order_relaxed)) {
        Sleep(100);
        if (!g_armed.load(std::memory_order_relaxed)) continue;

        // Re-enumerate threads; arm any that joined since last pass.
        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
        if (snap == INVALID_HANDLE_VALUE) continue;

        DWORD myPid   = GetCurrentProcessId();
        DWORD skipTid = g_watcher_thread_id;

        THREADENTRY32 te;
        te.dwSize = sizeof(te);
        if (Thread32First(snap, &te)) {
            do {
                if (te.th32OwnerProcessID != myPid)              continue;
                if (te.th32ThreadID == skipTid)                   continue;
                if (g_armed_threads.count(te.th32ThreadID) != 0) continue;
                // New thread — arm it.
                ArmWatchpointOnThread(te.th32ThreadID, g_armed_target);
            } while (Thread32Next(snap, &te));
        }
        CloseHandle(snap);
    }
}

// ---------------------------------------------------------------------------
// Install
// ---------------------------------------------------------------------------
bool Install()
{
    // Start the background re-enumerator thread first so g_watcher_thread_id
    // is populated before we potentially arm threads in Hook_TESCharUpdate.
    g_watcher_thread = new std::thread(WatcherThreadProc);

    // Register VEH (first in chain — priority 1).
    g_veh_handle = AddVectoredExceptionHandler(1, &OnException);
    if (!g_veh_handle) {
        _ERROR("[FlagWatch] AddVectoredExceptionHandler failed (%lu)", GetLastError());
        g_stop.store(true);
        if (g_watcher_thread->joinable()) g_watcher_thread->join();
        delete g_watcher_thread;
        g_watcher_thread = nullptr;
        return false;
    }

    // Install TESCharacter::Update detour.
    DetourTransactionBegin();
    DetourUpdateThread(GetCurrentThread());
    void* origBefore = (void*)s_orig_TESCharUpdate;
    DetourAttach(reinterpret_cast<PVOID*>(&s_orig_TESCharUpdate), Hook_TESCharUpdate);
    LONG res = DetourTransactionCommit();
    if (res != NO_ERROR) {
        _ERROR("[FlagWatch] DetourAttach failed (%ld)", res);
        RemoveVectoredExceptionHandler(g_veh_handle);
        g_veh_handle = nullptr;
        g_stop.store(true);
        if (g_watcher_thread->joinable()) g_watcher_thread->join();
        delete g_watcher_thread;
        g_watcher_thread = nullptr;
        return false;
    }

    _MESSAGE("[FlagWatch] detour: origAddr=%p trampoline=%p hook=%p",
             origBefore, (void*)s_orig_TESCharUpdate, (void*)&Hook_TESCharUpdate);

    return true;
}

// ---------------------------------------------------------------------------
// Shutdown — called from Main.cpp OnExitGame before Pipeline::Shutdown
// ---------------------------------------------------------------------------
void Shutdown()
{
    // Stop the background thread.
    g_stop.store(true);
    if (g_watcher_thread) {
        if (g_watcher_thread->joinable()) g_watcher_thread->join();
        delete g_watcher_thread;
        g_watcher_thread = nullptr;
    }

    // Disarm DR0 on all currently-armed threads.
    DisarmWatchpointOnAllThreads();

    // Remove VEH.
    if (g_veh_handle) {
        RemoveVectoredExceptionHandler(g_veh_handle);
        g_veh_handle = nullptr;
    }

    // Detach the Update hook.
    DetourTransactionBegin();
    DetourUpdateThread(GetCurrentThread());
    DetourDetach(reinterpret_cast<PVOID*>(&s_orig_TESCharUpdate), Hook_TESCharUpdate);
    DetourTransactionCommit();
}

}} // namespace StormLog::FlagWatch
